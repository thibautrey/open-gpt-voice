# Local development configuration for OpenGPT-Voice. Copy this file to .env.
OPENGPT_VOICE_BEARER_TOKEN=

# Local speech models
OPENGPT_VOICE_SILERO_MODEL_PATH=/models/silero_vad.onnx
OPENGPT_VOICE_WHISPER_MODEL_PATH=/models/faster-whisper

# GLiNER2.5-Decide model identifier; replace with its local snapshot path after download.
OPENGPT_VOICE_GLINER_MODEL_PATH=/models/gliner2.5-decide-onnx
OPENGPT_VOICE_GLINER_DEVICE=cuda

# LM Studio
OPENGPT_VOICE_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
OPENGPT_VOICE_LM_STUDIO_MODEL=local-model
